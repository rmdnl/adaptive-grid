BINANCE_ENV=testnet

EXECUTION_MODE=paper

DRY_RUN=true
ALLOW_LIVE_EXECUTION=false

PAIR_LIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT

INDICATOR_TIMEFRAME=1h

ADX_PERIOD=14
RSI_PERIOD=14
STOCH_RSI_LENGTH=14
STOCH_SMOOTH_K=3
STOCH_SMOOTH_D=3

ATR_PERIOD=14

# Regime + Recovery entry gate (ALL conditions):
# ADX < ENTRY_ADX_MAX and ADX not rising over ADX_REGIME_LOOKBACK bars,
# Stoch RSI %K crossing up through %D with %K < ENTRY_STOCH_K_MAX.
ENTRY_ADX_MAX=20
ADX_REGIME_LOOKBACK=3
ENTRY_STOCH_K_MAX=0.3

# Regime + Recovery exits:
# SOFT (cancel unfilled BUYs, let SELLs fill, no market sell):
#   ADX > EXIT_ADX_MIN and +DI > -DI, or Stoch RSI %K > EXIT_STOCH_K_MAX
# HARD (cancel all, verify, liquidate, verify):
#   ADX > EXIT_ADX_MIN and -DI > +DI, or a 15m lower-boundary breach
EXIT_ADX_MIN=25
EXIT_STOCH_K_MAX=0.8

# ATR-based grid step = ATR x ATR_GRID_MULTIPLIER; the adaptive planner
# never uses LESS than this: actual step = max(ATR x multiplier,
# economic minimum step derived from fees + slippage + required
# profitability). Legacy name GRID_STEP_ATR_MULTIPLIER is still accepted.
ATR_GRID_MULTIPLIER=1.0

GRID_GROSS_MIN=0.005
MIN_NET_PROFIT_PER_GRID=0.002

MAKER_FEE=0.001
TAKER_FEE=0.001
SLIPPAGE_ESTIMATE=0.0005

MAX_DRAWDOWN_PERCENT=2
STOP_IF_BELOW_LOWER_PERCENT=2

# Regime + Recovery pacing and lifecycle:
# MIN_HOURS_BETWEEN_ENTRIES: global minimum spacing between any two grid
# entries across ALL symbols (0 disables the pacing gate).
MIN_HOURS_BETWEEN_ENTRIES=48
# Grid step floor: actual step = max(ATR x ATR_GRID_MULTIPLIER,
# MIN_STEP_PERCENT x price, economic minimum step).
MIN_STEP_PERCENT=0.006
# SOFT exit cooldown (sells were left to fill, no liquidation).
SOFT_COOLDOWN_HOURS=2
# HARD exit cooldown (full liquidation happened).
HARD_COOLDOWN_HOURS=24
# TIME STOP: a grid older than HOLD_MAX_HOURS gets a SOFT exit; if
# inventory still remains after SOFT_COOLDOWN_HOURS, it escalates to HARD.
HOLD_MAX_HOURS=72

# Market data freshness: a strategy candle older than this (seconds) is
# stale — no orders that cycle (fail-closed). Must be >= the indicator
# timeframe interval. Default 21600 (6h).
# MAX_MARKET_DATA_AGE_SECONDS=21600

# Session capital override. 0 / absent = derive the paper/testnet session
# capital from the Binance testnet USDT balance at session creation.
# START_EQUITY=250

# Testnet keys: Spot trading permission only, withdrawal disabled.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Production keys: NEVER used unless EXECUTION_MODE=live and every live
# gate is explicitly satisfied. Keep them empty.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Adaptive Spot Grid (Phase 1)
# When ADAPTIVE_GRID=true (default), the following four parameters are
# computed automatically at runtime from ATR, market price, and available
# USDT balance. They need not be configured manually.
# When ADAPTIVE_GRID=false, all four must be explicitly provided.
ADAPTIVE_GRID=true

# Minimum and maximum candidate grid counts for automatic selection.
# The planner tests counts from MAX_GRIDS down to MIN_GRIDS and picks
# the highest passing count.
MIN_GRIDS=4
MAX_GRIDS=5

# Reserve % of available USDT that must not be allocated to grids.
# Example: QUOTE_RESERVE_PERCENT=20 keeps 20% of USDT as reserve.
QUOTE_RESERVE_PERCENT=20

# Maximum % of available USDT (after reserve) that can be allocated
# across all symbols in PAIR_LIST. Divided evenly per symbol.
# Example: MAX_QUOTE_ALLOCATION_PERCENT=80 allocates up to 80% of
# post-reserve USDT across all symbols.
MAX_QUOTE_ALLOCATION_PERCENT=80

# Static grid parameters (REQUIRED when ADAPTIVE_GRID=false):
# LOWER_PRICE={"BTC/USDT": 45000.0, "ETH/USDT": 3000.0}
# UPPER_PRICE={"BTC/USDT": 55000.0, "ETH/USDT": 3500.0}
# TOTAL_GRIDS=5
# TOTAL_QUOTE_BUDGET={"BTC/USDT": 1000.0, "ETH/USDT": 500.0}
# Phase 6A: Binance Spot Testnet read-only adapter.
# Testnet credentials are SEPARATE from production credentials.
# Do not reuse production secrets.
# API key must NOT have withdrawal permission.

BINANCE_ENV=testnet
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional transport tuning (Phase 6A adapter).
# Defaults: 5000ms timeout, 3 retries, 1000ms backoff.
BINANCE_TIMEOUT_MS=5000
BINANCE_RETRIES=3
BINANCE_BACKOFF_MS=1000

# Mandatory safety controls — do not change.
DRY_RUN=true
ALLOW_LIVE_EXECUTION=false

# =============================================================================
# BINANCE SPOT ADAPTIVE GRID BOT — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# MODE & SAFETY (mandatory)
# -----------------------------------------------------------------------------
# Mode: "testnet" (live execution is not implemented in this release)
BINANCE_ENV=testnet
# DRY_RUN must remain true; live execution is disabled in this release
DRY_RUN=true
# ALLOW_LIVE_EXECUTION must remain false
ALLOW_LIVE_EXECUTION=false

# -----------------------------------------------------------------------------
# STRATEGY PARAMETERS (.env is the operator-facing source of truth; the
# values in config.yaml are documented fallbacks)
# -----------------------------------------------------------------------------
# Comma-separated pairs (PAIR/QUOTE form). Overrides SYMBOLS.
PAIR_LIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT

# Indicator timeframe: 1h or 4h (closed candles only)
INDICATOR_TIMEFRAME=1h

# Indicator periods
ADX_PERIOD=14
RSI_PERIOD=14
BB_PERIOD=20
BB_STDDEV=2.0
ZSCORE_PERIOD=20
ATR_PERIOD=14
VO_FAST=5
VO_SLOW=10

# ENTRY (the ONLY mandatory entry filters — AND logic):
#   ADX(14) < ADX_ENTRY_MAX  AND  RSI(14) < RSI_ENTRY_MAX  AND  %B <= BB_ENTRY_MAX_PERCENT_B
# The Volume Oscillator is diagnostics only and NEVER gates entry.
ADX_ENTRY_MAX=25
RSI_ENTRY_MAX=40
BB_ENTRY_MAX_PERCENT_B=0

# EXIT (OR logic, at-or-beyond the threshold):
#   RSI >= RSI_EXIT_MIN  OR  ADX >= ADX_EXIT_MIN  OR  %B >= BB_EXIT_MIN_PERCENT_B
#   OR  |Z-Score| >= ZSCORE_ABS_EXIT
RSI_EXIT_MIN=70
ADX_EXIT_MIN=25
BB_EXIT_MIN_PERCENT_B=1
ZSCORE_ABS_EXIT=2.5

# Grid: step = GRID_STEP_ATR_MULTIPLIER x ATR(14); hard economics gates
GRID_STEP_ATR_MULTIPLIER=1.0
GRID_GROSS_MIN=0.005
MIN_NET_PROFIT_PER_GRID=0.003

# Risk
MAX_DRAWDOWN_PERCENT=2
STOP_IF_BELOW_LOWER_PERCENT=2

# Cooldown after auto-exit (hours, symbol-specific)
COOLDOWN_HOURS=3

# -----------------------------------------------------------------------------
# MULTI-SYMBOL CONFIGURATION (fallback when PAIR_LIST is unset)
# -----------------------------------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT

# -----------------------------------------------------------------------------
# BINANCE TESTNET CREDENTIALS (separate from production)
# -----------------------------------------------------------------------------
# Get testnet API keys from https://testnet.binance.vision/
# API key must NOT have withdrawal permission.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# -----------------------------------------------------------------------------
# BINANCE LIVE CREDENTIALS (production — never used in this release)
# -----------------------------------------------------------------------------
# LIVE credentials are never read while BINANCE_ENV=testnet.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# -----------------------------------------------------------------------------
# BINANCE TRANSPORT TUNING (optional)
# -----------------------------------------------------------------------------
BINANCE_TIMEOUT_MS=5000
BINANCE_RETRIES=3
BINANCE_BACKOFF_MS=1000

# -----------------------------------------------------------------------------
# TESTNET EXECUTION BRIDGE (real orders on TESTNET only) — double-gated
# Requires ALSO execution.testnet_execution: true in config.yaml.
# -----------------------------------------------------------------------------
TESTNET_ORDERS_ENABLED=false

# -----------------------------------------------------------------------------
# DASHBOARD CONFIGURATION (optional)
# -----------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
GRID_DB_PATH=./data/grid_bot.sqlite3

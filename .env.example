# =============================================================================
# BINANCE SPOT ADAPTIVE GRID BOT — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# MODE & SAFETY (mandatory)
# -----------------------------------------------------------------------------
# Mode: "testnet" or "live" (matches config.yaml environment.mode)
BINANCE_ENV=testnet
# DRY_RUN must remain true; live execution is disabled in this release
DRY_RUN=true
# ALLOW_LIVE_EXECUTION must remain false
ALLOW_LIVE_EXECUTION=false

# -----------------------------------------------------------------------------
# MULTI-SYMBOL CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of spot symbols (e.g., BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT)
# Overrides config.yaml `symbols` if set
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT

# -----------------------------------------------------------------------------
# BINANCE TESTNET CREDENTIALS (separate from production)
# -----------------------------------------------------------------------------
# Get testnet API keys from https://testnet.binance.vision/
# API key must NOT have withdrawal permission.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# -----------------------------------------------------------------------------
# BINANCE LIVE CREDENTIALS (production — USE WITH EXTREME CAUTION)
# -----------------------------------------------------------------------------
# Get live API keys from https://www.binance.com/en/my/settings/api-management
# API key must NOT have withdrawal permission.
# ONLY used when BINANCE_ENV=live AND config.yaml allow_live_execution=true
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# -----------------------------------------------------------------------------
# BINANCE TRANSPORT TUNING (optional, both testnet & live)
# -----------------------------------------------------------------------------
# Defaults: 5000ms timeout, 3 retries, 1000ms backoff
BINANCE_TIMEOUT_MS=5000
BINANCE_RETRIES=3
BINANCE_BACKOFF_MS=1000

# -----------------------------------------------------------------------------
# DASHBOARD CONFIGURATION (optional)
# -----------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
GRID_DB_PATH=./data/grid_bot.sqlite3
BINANCE_ENV=testnet

DRY_RUN=true
ALLOW_LIVE_EXECUTION=false

PAIR_LIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT

INDICATOR_TIMEFRAME=4h

ADX_PERIOD=14
RSI_PERIOD=14
BB_PERIOD=20
BB_STD=2

VO_FAST=5
VO_SLOW=10

ZSCORE_PERIOD=20

ATR_PERIOD=14

ENTRY_ADX_MAX=20
ENTRY_RSI_MAX=35
ENTRY_VOLUME_OSC_MIN=0
ENTRY_BB_PERCENT_B_MAX=0

EXIT_RSI_MIN=70
EXIT_ADX_MIN=25
EXIT_BB_PERCENT_B_MIN=1
EXIT_ZSCORE_ABS_MAX=2.5

GRID_STEP_ATR_MULTIPLIER=1.0

GRID_GROSS_MIN=0.005
MIN_NET_PROFIT_PER_GRID=0.002

MAKER_FEE=0.001
TAKER_FEE=0.001
SLIPPAGE_ESTIMATE=0.0005

MAX_DRAWDOWN_PERCENT=2
STOP_IF_BELOW_LOWER_PERCENT=2

# Equity anchor (quote) for drawdown measurement: equity = START_EQUITY +
# realized PnL - fees + unrealized PnL.
START_EQUITY=1000

COOLDOWN_HOURS=3

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
